<UserControl
    x:Class="Cerith.WidgetHost.MetricReadout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid MinHeight="70">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="StateRail"
                Width="2"
                Margin="0,12,0,12"
                Background="{ThemeResource CerithAccentBrush}" />

        <Grid Grid.Column="1" Padding="15,11,2,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="LabelText"
                           Foreground="{ThemeResource CerithTextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="StateText"
                               Foreground="{ThemeResource CerithMutedTextBrush}"
                               FontSize="11" />
                    <TextBlock Text="·"
                               Foreground="{ThemeResource CerithMutedTextBrush}"
                               FontSize="11" />
                    <TextBlock x:Name="ConfidenceText"
                               Foreground="{ThemeResource CerithMutedTextBrush}"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ValueText"
                       Grid.Column="1"
                       MaxWidth="176"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource CerithTextBrush}"
                       FontSize="23"
                       FontWeight="SemiBold"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Column="1"
                Height="1"
                Margin="15,0,0,0"
                VerticalAlignment="Bottom"
                Background="{ThemeResource CerithSeparatorBrush}" />
    </Grid>
</UserControl>
