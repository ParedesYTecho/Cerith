<UserControl
    x:Class="Cerith.WidgetHost.MetricReadout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid MinHeight="64">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Live" />
                <VisualState x:Name="Stale">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource CerithStaleBrush}" />
                        <Setter Target="ValueText.Opacity" Value="0.6" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource CerithErrorBrush}" />
                        <Setter Target="ValueText.Foreground" Value="{ThemeResource CerithMutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Off">
                    <VisualState.Setters>
                        <Setter Target="StateDot.Fill" Value="{ThemeResource CerithSeparatorBrush}" />
                        <Setter Target="ValueText.Foreground" Value="{ThemeResource CerithMutedTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Padding="0,10,0,11" ColumnSpacing="16" RowSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="LabelText"
                       VerticalAlignment="Center"
                       Style="{StaticResource CerithLabelTextStyle}" />
            <TextBlock x:Name="ValueText"
                       Grid.Column="1"
                       MaxWidth="176"
                       VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"
                       Style="{StaticResource CerithValueTextStyle}" />

            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StateDot"
                         Width="6"
                         Height="6"
                         Margin="0,5,0,0"
                         VerticalAlignment="Top"
                         Fill="{ThemeResource CerithAccentBrush}" />
                <TextBlock x:Name="StateText" Grid.Column="1" Style="{StaticResource CerithCaptionTextStyle}" />
                <TextBlock x:Name="ConfidenceText" Grid.Column="2" Style="{StaticResource CerithCaptionTextStyle}" />
            </Grid>
        </Grid>

        <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource CerithSeparatorBrush}" />
    </Grid>
</UserControl>
