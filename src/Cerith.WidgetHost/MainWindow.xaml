<Window
    x:Class="Cerith.WidgetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource CerithSurfaceBrush}">
        <Grid Padding="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="CERITH"
                               Foreground="{ThemeResource CerithMutedTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               CharacterSpacing="180" />
                    <TextBlock Text="Live metrics"
                               Foreground="{ThemeResource CerithTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="3">
                    <TextBlock Text="LOCAL"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource CerithMutedTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               CharacterSpacing="120" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Height="14" Margin="0,10,0,0">
                <Border Width="28"
                        Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CerithAccentBrush}" />
                <Border Height="1"
                        Margin="40,0,0,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource CerithSeparatorBrush}" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="5" Margin="0,0,0,8">
                <Button x:Name="ConfigureButton" Content="Configure metrics" Click="OnConfigure" IsEnabled="False" />
                <TextBlock x:Name="StorageWarning" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MetricsPanel" VerticalAlignment="Top" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
