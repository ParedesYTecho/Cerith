<Window
    x:Class="Cerith.WidgetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource CerithSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <!-- Width of the three system caption buttons. -->
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleDrag" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                            <Path Fill="{ThemeResource CerithAccentBrush}"
                                  Data="M11,2 A8,8 0 1 0 11,18 A6.2,8 0 1 1 11,2 Z" />
                            <Path Fill="{ThemeResource CerithTextBrush}"
                                  Data="M13,6.5 L13.9,9.1 L16.5,10 L13.9,10.9 L13,13.5 L12.1,10.9 L9.5,10 L12.1,9.1 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="Wordmark"
                               Text="Cerith"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CerithBrandFont}"
                               FontSize="18"
                               Foreground="{ThemeResource CerithTextBrush}" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="NormalActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ConfigureButton" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE713;"
                        AutomationProperties.Name="Configure metrics" ToolTipService.ToolTip="Configure metrics"
                        Click="OnConfigure" IsEnabled="False" />
                <Button x:Name="DetailsButton" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE8FD;"
                        AutomationProperties.Name="Composition details" ToolTipService.ToolTip="Composition details"
                        Click="OnToggleDetails" />
                <Button x:Name="CompactButton" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE73F;"
                        AutomationProperties.Name="Compact" ToolTipService.ToolTip="Compact"
                        Click="OnToggleCompact" />
            </StackPanel>
            <StackPanel x:Name="CompactActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <ToggleButton x:Name="CompactPinButton" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE718;"
                              AutomationProperties.Name="Keep Cerith on top" ToolTipService.ToolTip="Keep on top"
                              Click="OnTogglePin" />
                <Button x:Name="ExpandButton" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE740;"
                        AutomationProperties.Name="Expand" ToolTipService.ToolTip="Expand"
                        Click="OnToggleCompact" />
            </StackPanel>
        </Grid>

        <Grid x:Name="NormalShell" Grid.Row="1" Padding="20,0,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StorageWarning" Margin="0,0,0,8" Visibility="Collapsed"
                       Style="{StaticResource CerithCaptionTextStyle}"
                       Foreground="{ThemeResource CerithStaleBrush}" />
            <Grid Grid.Row="1">
                <Grid x:Name="OverviewView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="OverviewViewport">
                        <StackPanel x:Name="OverviewPanel" VerticalAlignment="Top" />
                        <TextBlock x:Name="OverviewSizeWarning" Visibility="Collapsed"
                                   Style="{StaticResource CerithCaptionTextStyle}"
                                   Text="This metric needs more space. Enlarge the window or open Composition details." />
                    </Grid>
                    <Grid x:Name="OverviewNavigation" Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PreviousButton" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE76B;"
                                AutomationProperties.Name="Previous" ToolTipService.ToolTip="Previous" Click="OnPrevious" />
                        <TextBlock x:Name="PageText" Grid.Column="1" VerticalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource CerithCaptionTextStyle}" />
                        <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource CerithIconButtonStyle}" Content="&#xE76C;"
                                AutomationProperties.Name="Next" ToolTipService.ToolTip="Next" Click="OnNext" />
                    </Grid>
                </Grid>
                <!-- The negative margin puts the overlay scrollbar in the window gutter, clear of the values. -->
                <ScrollViewer x:Name="DetailsView" Visibility="Collapsed" Margin="0,0,-16,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MetricsPanel" Margin="0,0,16,0" VerticalAlignment="Top" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="CompactShell" Grid.Row="1" Visibility="Collapsed" Padding="16,0,16,8"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CompactPanel" />
        </ScrollViewer>
    </Grid>
</Window>
