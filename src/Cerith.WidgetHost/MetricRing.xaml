<UserControl
    x:Class="Cerith.WidgetHost.MetricRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel>
        <ContentControl x:Name="ReadoutHost" IsTabStop="False" HorizontalContentAlignment="Stretch" />
        <StackPanel Margin="17,0,2,10" Spacing="4">
            <Grid x:Name="Ring" Width="32" Height="32" HorizontalAlignment="Left" Visibility="Collapsed">
                <Ellipse StrokeThickness="3" Stroke="{ThemeResource CerithSeparatorBrush}" />
                <Path x:Name="Fill" StrokeThickness="3" Stroke="{ThemeResource CerithAccentBrush}" Visibility="Collapsed">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="16,1.5" IsClosed="False" IsFilled="False">
                                <ArcSegment x:Name="Arc" Size="14.5,14.5" Point="16,1.5" SweepDirection="Clockwise" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <Ellipse x:Name="FullFill" StrokeThickness="3"
                         Stroke="{ThemeResource CerithAccentBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="RangeText" FontSize="10"
                       Foreground="{ThemeResource CerithMutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
